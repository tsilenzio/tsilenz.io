---
import Base from '@layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing — Taylor Silenzio" description="Blog posts and technical writing.">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-20">
    <h1 class="text-3xl font-bold tracking-tight mb-2">Writing</h1>
    <p class="text-(--color-text-muted) mb-10">Thoughts on software, tools, and building things.</p>

    {
      posts.length > 0 ? (
        <div class="space-y-4">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="group block rounded-lg p-4 -mx-4 hover:bg-(--color-bg-alt) transition-colors"
            >
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-medium group-hover:text-(--color-accent) transition-colors">
                  {post.data.title}
                </h2>
                <time
                  class="shrink-0 text-sm text-(--color-text-muted)"
                  datetime={post.data.date.toISOString()}
                >
                  {post.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </time>
              </div>
              {post.data.description && (
                <p class="mt-1 text-sm text-(--color-text-muted)">{post.data.description}</p>
              )}
            </a>
          ))}
        </div>
      ) : (
        <p class="text-(--color-text-muted)">Nothing here yet. Check back soon.</p>
      )
    }
  </div>
</Base>

---
import Base from '@layouts/Base.astro';

const variants = [
  { href: '/404-rust', name: 'rust compiler error' },
  { href: '/404-man', name: 'unix man page' },
  { href: '/404-shell', name: 'shell session' },
  { href: '/404-oneliner', name: 'dry one-liner' },
];
---

<Base title="404 previews — Taylor Silenzio">
  <div class="mx-auto max-w-3xl px-6 pt-24 pb-20">
    <h1 class="text-2xl font-bold">404 previews</h1>
    <p class="mt-2 text-(--color-text-muted)">Four variants to try on for size.</p>
    <ul class="mt-6 space-y-3">
      {
        variants.map(({ href, name }) => (
          <li>
            <a href={href} class="hover:underline">
              {name}
            </a>{' '}
            <span class="text-(--color-text-muted) font-mono text-sm">{href}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-sm text-(--color-text-muted)">
      Current live 404 still lives at any unknown URL, e.g.
      <a href="/definitely-does-not-exist" class="hover:underline">/definitely-does-not-exist</a>.
    </p>
  </div>
</Base>

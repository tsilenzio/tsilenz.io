---
import PageLayout from '@layouts/PageLayout.astro';
import '../styles/error.css';

const placeholderPath = '/the-page-you-wanted';
const placeholderCarets = '^'.repeat(placeholderPath.length);
const placeholderHost = 'tsilenz.io';
---

<PageLayout title="404 — Taylor Silenzio">
  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <div class="overflow-hidden rounded-lg border border-(--color-border) bg-(--color-bg-alt)">
      <div
        class="border-b border-(--color-border) px-4 py-2 font-mono text-xs text-(--color-text-muted)"
      >
        $ cargo build
      </div>
      <div class="overflow-x-auto p-6">
        <pre
          class="font-mono text-sm leading-6 whitespace-pre text-(--color-text)"><span class="font-semibold text-red-400" data-rust-code>error[E0404]</span>: <span data-error-phrase>cannot find page</span> <span class="text-red-400">`<span data-path>{placeholderPath}</span>`</span> in site `<span data-site-host>{placeholderHost}</span>`
 <span class="font-semibold text-(--color-accent)">{'-->'}</span> <span data-site-host>{placeholderHost}</span><span data-path>{placeholderPath}</span>
  <span class="font-semibold text-(--color-accent)">|</span>
<span class="font-semibold text-(--color-accent)">1 |</span>     GET <span data-path>{placeholderPath}</span>
  <span class="font-semibold text-(--color-accent)">|</span>         <span class="font-semibold text-red-400" data-carets>{placeholderCarets}</span> <span class="text-red-400" data-trail-label>not found in this site</span>
  <span class="font-semibold text-(--color-accent)">|</span>
  <span class="font-semibold text-(--color-accent)">=</span> <span class="font-semibold">help</span>: try one of these instead:
<span class="pill-group"><span class="pill" aria-hidden="true" />          <a href="/" class="hit-wide hover:underline">/</a>
          <a href="/blog" class="hit-wide hover:underline">/blog</a>
          <a href="/#projects" class="hit-wide hover:underline">/#projects</a></span>

<span class="font-semibold text-red-400">error</span>: aborting due to previous error

For more information about this error, try <a href="/" class="hit hover:underline">`go home`</a>.</pre>
      </div>
    </div>
  </div>
  <script>
    import { getPageContext, truncateMiddle, initMagicPill } from '@scripts/error-page';

    const BASELINE_MAX_DISPLAY = 25;
    const MIN_DISPLAY = 14;
    const BASELINE_PHRASE = 'cannot find page';
    const BASELINE_HOST = 'tsilenz.io';

    const ctx = getPageContext();
    const statusInfo = ctx.statusInfo;

    document.title = `${ctx.status} — Taylor Silenzio`;

    document.querySelectorAll<HTMLElement>('[data-rust-code]').forEach((el) => {
      el.textContent = `error[${statusInfo.rustCode}]`;
    });
    document.querySelectorAll<HTMLElement>('[data-error-phrase]').forEach((el) => {
      el.textContent = statusInfo.errorPhrase;
    });
    document.querySelectorAll<HTMLElement>('[data-trail-label]').forEach((el) => {
      el.textContent = statusInfo.rustTrailLabel;
    });
    document.querySelectorAll<HTMLElement>('[data-site-host]').forEach((el) => {
      el.textContent = ctx.hostname;
    });

    const statusPenalty = Math.max(0, statusInfo.errorPhrase.length - BASELINE_PHRASE.length);
    const hostPenalty = Math.max(0, ctx.hostname.length - BASELINE_HOST.length);
    const maxDisplay = Math.max(MIN_DISPLAY, BASELINE_MAX_DISPLAY - statusPenalty - hostPenalty);

    const displayPath = truncateMiddle(ctx.path, maxDisplay);
    const truncated = displayPath !== ctx.path;

    document.querySelectorAll<HTMLElement>('[data-path]').forEach((el) => {
      el.textContent = displayPath;
      if (truncated) el.setAttribute('title', ctx.path);
      else el.removeAttribute('title');
    });
    document.querySelectorAll<HTMLElement>('[data-carets]').forEach((el) => {
      el.textContent = '^'.repeat(displayPath.length);
    });

    document.querySelectorAll<HTMLElement>('.pill-group').forEach((group) => {
      initMagicPill(group);
    });
  </script>
</PageLayout>

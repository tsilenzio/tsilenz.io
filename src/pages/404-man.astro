---
import Base from '@layouts/Base.astro';

const path = '/the-page-you-wanted';
const hostname = 'tsilenz.io';
const today = '2026-04-22';
---

<Base title="404 (man) — Taylor Silenzio">
  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <div class="overflow-hidden rounded-lg border border-(--color-border) bg-(--color-bg-alt)">
      <div class="border-b border-(--color-border) px-4 py-2 font-mono text-xs text-(--color-text-muted)">
        $ man notfound
      </div>
      <div class="overflow-x-auto p-6">
        <pre class="font-mono text-sm leading-6 whitespace-pre text-(--color-text)">NOTFOUND(4)                  Site Manual                  NOTFOUND(4)

<span class="font-semibold">NAME</span>
       <span data-url>{hostname}{path}</span> - page that does not exist

<span class="font-semibold">SYNOPSIS</span>
       GET <span data-path>{path}</span>

<span class="font-semibold">DESCRIPTION</span>
       The requested URL does not correspond to any resource on
       this site. It may have been moved, renamed, or never
       written in the first place.

<span class="font-semibold">EXIT STATUS</span>
       404    Not Found

<span class="font-semibold">SEE ALSO</span>
       <span class="pill-group"><span class="pill" aria-hidden="true"></span><span data-see-also><a href="/" class="man-link hover:underline">home(1)</a>, <a href="/blog" class="man-link hover:underline">blog(1)</a></span></span>

<span data-footer>{hostname}                    {today}                  NOTFOUND(4)</span></pre>
      </div>
    </div>
  </div>
  <style is:global>
    .man-link {
      position: relative;
      isolation: isolate;
      transition: color 0.12s ease;
    }
    .man-link::before {
      content: '';
      position: absolute;
      top: -0.3rem;
      bottom: -0.3rem;
      left: -0.5rem;
      right: -0.5rem;
      border-radius: 0.25rem;
      z-index: -1;
      transition: background 0.12s ease;
    }
    .man-link:hover {
      color: var(--color-accent);
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 4px;
    }
    .man-link:hover::before {
      background: var(--color-accent-muted);
    }
    .pill-group {
      position: relative;
      isolation: isolate;
    }
    .pill {
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      background: var(--color-accent-muted);
      border-radius: 0.25rem;
      pointer-events: none;
      z-index: -1;
      opacity: 0;
      transform: translate(0, 0);
      transition:
        transform 180ms cubic-bezier(0.4, 0, 0.2, 1),
        width 180ms cubic-bezier(0.4, 0, 0.2, 1),
        height 180ms cubic-bezier(0.4, 0, 0.2, 1),
        opacity 120ms ease;
      will-change: transform, width, height;
    }
    .pill[data-active='true'] {
      opacity: 1;
    }
    .pill-group[data-magic='active'] .man-link:hover::before {
      background: transparent;
    }
    @media (prefers-reduced-motion: reduce) {
      .pill {
        transition: opacity 80ms ease;
      }
    }
  </style>
  <script is:inline>
    (function () {
      function stripWww(host) {
        return host.indexOf('www.') === 0 ? host.slice(4) : host;
      }
      function normalizeHost(host) {
        var stripped = stripWww(host);
        if (stripped === 'localhost' || stripped === '127.0.0.1' || stripped === '0.0.0.0' || stripped === '[::1]') {
          return 'tsilenz.io';
        }
        return stripped;
      }

      var params = new URLSearchParams(window.location.search);
      var path = params.get('path') || window.location.pathname;
      var rawHost = params.get('hostname') || window.location.hostname;
      var hostname = normalizeHost(rawHost);
      var url = hostname + path;
      var isMainSite = hostname === 'tsilenz.io';

      var MARKER = '[..]';
      function truncateMiddle(s, max) {
        if (s.length <= max) return s;
        var keep = max - MARKER.length;
        var left = Math.ceil(keep / 2);
        var right = Math.floor(keep / 2);
        return s.slice(0, left) + MARKER + s.slice(s.length - right);
      }

      var maxPath = Math.max(16, 46 - hostname.length);
      var displayPath = truncateMiddle(path, maxPath);
      var truncated = displayPath !== path;
      var displayUrl = hostname + displayPath;

      document.querySelectorAll('[data-path]').forEach(function (el) {
        el.textContent = displayPath;
        if (truncated) el.setAttribute('title', path);
        else el.removeAttribute('title');
      });
      document.querySelectorAll('[data-url]').forEach(function (el) {
        el.textContent = displayUrl;
        if (truncated) el.setAttribute('title', url);
        else el.removeAttribute('title');
      });

      var footerEl = document.querySelector('[data-footer]');
      if (footerEl) {
        var date = '2026-04-22';
        var right = 'NOTFOUND(4)';
        var width = 70;
        var gaps = width - hostname.length - date.length - right.length;
        if (gaps < 2) gaps = 2;
        var gap1 = ' '.repeat(Math.floor(gaps / 2));
        var gap2 = ' '.repeat(gaps - Math.floor(gaps / 2));
        footerEl.textContent = hostname + gap1 + date + gap2 + right;
      }

      var seeAlsoEl = document.querySelector('[data-see-also]');
      if (!seeAlsoEl) return;

      while (seeAlsoEl.firstChild) seeAlsoEl.removeChild(seeAlsoEl.firstChild);

      var entries = [];

      if (isMainSite) {
        [
          { href: '/', label: 'home(1)' },
          { href: '/blog', label: 'blog(1)' },
          { href: '/#projects', label: 'projects(1)' },
        ].forEach(function (p) {
          var a = document.createElement('a');
          a.href = p.href;
          a.textContent = p.label;
          a.className = 'man-link hover:underline';
          entries.push(a);
        });
      } else {
        var backLink = document.createElement('a');
        backLink.href = '#';
        backLink.textContent = 'back(1)';
        backLink.className = 'man-link hover:underline';
        backLink.addEventListener('click', function (e) {
          e.preventDefault();
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = 'https://tsilenz.io/';
          }
        });
        entries.push(backLink);

        var ref = document.referrer;
        if (ref) {
          try {
            var refUrl = new URL(ref);
            var refHost = stripWww(refUrl.hostname);
            if (refHost && refHost !== hostname) {
              var refLink = document.createElement('a');
              refLink.href = ref;
              refLink.textContent = refHost + '(1)';
              refLink.className = 'man-link hover:underline';
              entries.push(refLink);
            }
          } catch (e) {}
        }

        var homeLink = document.createElement('a');
        homeLink.href = 'https://tsilenz.io/';
        homeLink.textContent = 'tsilenz.io(1)';
        homeLink.className = 'man-link hover:underline';
        entries.push(homeLink);
      }

      entries.forEach(function (el, i) {
        if (i > 0) seeAlsoEl.appendChild(document.createTextNode(', '));
        seeAlsoEl.appendChild(el);
      });

      document.querySelectorAll('.pill-group').forEach(function (group) {
        var pill = group.querySelector('.pill');
        if (!pill) return;

        var links = group.querySelectorAll('.man-link');
        if (links.length === 0) return;

        group.dataset.magic = 'active';

        var visible = false;
        var leaveTimer = null;

        function setPill(target, skipSlide) {
          if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }

          var targetRect = target.getBoundingClientRect();
          var groupRect = group.getBoundingClientRect();
          var extendX = 8;
          var extendY = 5;
          var top = targetRect.top - groupRect.top - extendY;
          var left = targetRect.left - groupRect.left - extendX;
          var width = targetRect.width + extendX * 2;
          var height = targetRect.height + extendY * 2;

          if (skipSlide) {
            pill.style.transition = 'opacity 120ms ease';
          } else {
            pill.style.transition = '';
          }

          pill.style.transform = 'translate(' + left + 'px, ' + top + 'px)';
          pill.style.width = width + 'px';
          pill.style.height = height + 'px';
          pill.setAttribute('data-active', 'true');
          visible = true;
        }

        function hidePill() {
          pill.removeAttribute('data-active');
          visible = false;
        }

        links.forEach(function (link) {
          link.addEventListener('mouseenter', function () {
            setPill(link, !visible);
          });
          link.addEventListener('focus', function () {
            setPill(link, !visible);
          });
        });

        group.addEventListener('mouseleave', function () {
          if (leaveTimer) clearTimeout(leaveTimer);
          leaveTimer = setTimeout(hidePill, 60);
        });

        group.addEventListener('focusout', function (e) {
          if (!group.contains(e.relatedTarget)) {
            if (leaveTimer) clearTimeout(leaveTimer);
            leaveTimer = setTimeout(hidePill, 60);
          }
        });
      });
    })();
  </script>
</Base>

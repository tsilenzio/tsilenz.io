---
import Base from '@layouts/Base.astro';
import '../styles/error.css';

const path = '/the-page-you-wanted';
const hostname = 'tsilenz.io';
const today = '2026-04-22';
---

<Base title="404 (man) — Taylor Silenzio">
  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <div class="overflow-hidden rounded-lg border border-(--color-border) bg-(--color-bg-alt)">
      <div class="border-b border-(--color-border) px-4 py-2 font-mono text-xs text-(--color-text-muted)">
        $ man notfound
      </div>
      <div class="overflow-x-auto p-6">
        <pre class="font-mono text-sm leading-6 whitespace-pre text-(--color-text)">NOTFOUND(4)                  Site Manual                  NOTFOUND(4)

<span class="font-semibold">NAME</span>
       <span data-url>{hostname}{path}</span> - page that does not exist

<span class="font-semibold">SYNOPSIS</span>
       GET <span data-path>{path}</span>

<span class="font-semibold">DESCRIPTION</span>
       The requested URL does not correspond to any resource on
       this site. It may have been moved, renamed, or never
       written in the first place.

<span class="font-semibold">EXIT STATUS</span>
       404    Not Found

<span class="font-semibold">SEE ALSO</span>
       <span class="pill-group"><span class="pill" aria-hidden="true"></span><span data-see-also><a href="/" class="hit hover:underline">home(1)</a>, <a href="/blog" class="hit hover:underline">blog(1)</a></span></span>

<span data-footer>{hostname}                    {today}                  NOTFOUND(4)</span></pre>
      </div>
    </div>
  </div>
  <script>
    import { getPageContext, truncateMiddle, stripWww, initMagicPill } from '@scripts/error-page';

    const ctx = getPageContext();
    const isMainSite = ctx.hostname === 'tsilenz.io';

    const maxPath = Math.max(16, 46 - ctx.hostname.length);
    const displayPath = truncateMiddle(ctx.path, maxPath);
    const truncated = displayPath !== ctx.path;
    const displayUrl = ctx.hostname + displayPath;

    document.querySelectorAll<HTMLElement>('[data-path]').forEach((el) => {
      el.textContent = displayPath;
      if (truncated) el.setAttribute('title', ctx.path);
      else el.removeAttribute('title');
    });
    document.querySelectorAll<HTMLElement>('[data-url]').forEach((el) => {
      el.textContent = displayUrl;
      if (truncated) el.setAttribute('title', ctx.url);
      else el.removeAttribute('title');
    });

    const footerEl = document.querySelector<HTMLElement>('[data-footer]');
    if (footerEl) {
      const date = '2026-04-22';
      const right = 'NOTFOUND(4)';
      const width = 70;
      let gaps = width - ctx.hostname.length - date.length - right.length;
      if (gaps < 2) gaps = 2;
      const gap1 = ' '.repeat(Math.floor(gaps / 2));
      const gap2 = ' '.repeat(gaps - Math.floor(gaps / 2));
      footerEl.textContent = ctx.hostname + gap1 + date + gap2 + right;
    }

    const seeAlsoEl = document.querySelector<HTMLElement>('[data-see-also]');
    if (seeAlsoEl) {
      while (seeAlsoEl.firstChild) seeAlsoEl.removeChild(seeAlsoEl.firstChild);

      const entries: HTMLAnchorElement[] = [];

      if (isMainSite) {
        [
          { href: '/', label: 'home(1)' },
          { href: '/blog', label: 'blog(1)' },
          { href: '/#projects', label: 'projects(1)' },
        ].forEach((p) => {
          const a = document.createElement('a');
          a.href = p.href;
          a.textContent = p.label;
          a.className = 'hit hover:underline';
          entries.push(a);
        });
      } else {
        const backLink = document.createElement('a');
        backLink.href = '#';
        backLink.textContent = 'back(1)';
        backLink.className = 'hit hover:underline';
        backLink.addEventListener('click', (e) => {
          e.preventDefault();
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = 'https://tsilenz.io/';
          }
        });
        entries.push(backLink);

        const ref = document.referrer;
        if (ref) {
          try {
            const refUrl = new URL(ref);
            const refHost = stripWww(refUrl.hostname);
            if (refHost && refHost !== ctx.hostname) {
              const refLink = document.createElement('a');
              refLink.href = ref;
              refLink.textContent = `${refHost}(1)`;
              refLink.className = 'hit hover:underline';
              entries.push(refLink);
            }
          } catch {
            /* ignore malformed referrer */
          }
        }

        const homeLink = document.createElement('a');
        homeLink.href = 'https://tsilenz.io/';
        homeLink.textContent = 'tsilenz.io(1)';
        homeLink.className = 'hit hover:underline';
        entries.push(homeLink);
      }

      entries.forEach((el, i) => {
        if (i > 0) seeAlsoEl.appendChild(document.createTextNode(', '));
        seeAlsoEl.appendChild(el);
      });
    }

    document.querySelectorAll<HTMLElement>('.pill-group').forEach((group) => {
      initMagicPill(group);
    });
  </script>
</Base>

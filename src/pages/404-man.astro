---
import Base from '@layouts/Base.astro';
import '../styles/error.css';

const placeholderPath = '/the-page-you-wanted';
const placeholderHost = 'tsilenz.io';
const placeholderDate = new Date().toISOString().slice(0, 10);
---

<Base title="404 (man) — Taylor Silenzio">
  <div class="mx-auto max-w-3xl px-6 pt-20 pb-20">
    <div class="overflow-hidden rounded-lg border border-(--color-border) bg-(--color-bg-alt)">
      <div
        class="border-b border-(--color-border) px-4 py-2 font-mono text-xs text-(--color-text-muted)"
      >
        $ man <span data-command-subject>notfound</span>
      </div>
      <div class="overflow-x-auto p-6">
        <pre
          class="font-mono text-sm leading-6 whitespace-pre text-(--color-text)"
          data-pre><span data-header-line>NOTFOUND(404)                 Site Manual                 NOTFOUND(404)</span>

<span class="font-semibold">NAME</span>
       <span data-url>{placeholderHost}{placeholderPath}</span> - <span data-name-desc>page that does not exist</span>

<span class="font-semibold">SYNOPSIS</span>
       GET <span data-path>{placeholderPath}</span>

<span class="font-semibold">DESCRIPTION</span>
       The requested URL does not correspond to any resource on
       this site. It may have been moved, renamed, or never
       written in the first place.

<span class="font-semibold">EXIT STATUS</span>
       <span data-exit-line>404    Not Found</span>

<span class="font-semibold">SEE ALSO</span>
       <span class="pill-group"><span class="pill" aria-hidden="true" /><span data-see-also><a href="/" class="hit hover:underline">home(1)</a>, <a href="/blog" class="hit hover:underline">blog(1)</a></span></span>

<span data-footer>{placeholderHost}                  {placeholderDate}                 NOTFOUND(404)</span></pre>
      </div>
    </div>
  </div>
  <script>
    import {
      getPageContext,
      truncateMiddle,
      stripWww,
      initMagicPill,
      measureContainerChars,
      buildAlignedLine,
    } from '@scripts/error-page';

    const LINK_CLASS = 'hit hover:underline';
    const MAX_PATH_WITH_HOST = 46;
    const MIN_PATH = 16;
    const MAIN_SITE = 'tsilenz.io';
    const MAIN_SITE_URL = 'https://tsilenz.io/';

    const ctx = getPageContext();
    const statusInfo = ctx.statusInfo;
    const subjectToken = `${statusInfo.manSubject}(${ctx.status})`;
    const isMainSite = ctx.hostname === MAIN_SITE;
    const today = new Date().toISOString().slice(0, 10);

    document.title = `${ctx.status} — Taylor Silenzio`;

    document.querySelectorAll<HTMLElement>('[data-command-subject]').forEach((el) => {
      el.textContent = statusInfo.manSubject.toLowerCase();
    });
    document.querySelectorAll<HTMLElement>('[data-name-desc]').forEach((el) => {
      el.textContent = statusInfo.manNameDesc;
    });
    document.querySelectorAll<HTMLElement>('[data-exit-line]').forEach((el) => {
      el.textContent = `${ctx.status}    ${statusInfo.exitLabel}`;
    });

    const maxPath = Math.max(MIN_PATH, MAX_PATH_WITH_HOST - ctx.hostname.length);
    const displayPath = truncateMiddle(ctx.path, maxPath);
    const truncated = displayPath !== ctx.path;
    const displayUrl = ctx.hostname + displayPath;

    document.querySelectorAll<HTMLElement>('[data-path]').forEach((el) => {
      el.textContent = displayPath;
      if (truncated) el.setAttribute('title', ctx.path);
      else el.removeAttribute('title');
    });
    document.querySelectorAll<HTMLElement>('[data-url]').forEach((el) => {
      el.textContent = displayUrl;
      if (truncated) el.setAttribute('title', ctx.url);
      else el.removeAttribute('title');
    });

    function applyAlignment(): void {
      const pre = document.querySelector<HTMLElement>('[data-pre]');
      if (!pre) return;
      const width = measureContainerChars(pre);
      const headerEl = document.querySelector<HTMLElement>('[data-header-line]');
      if (headerEl) {
        headerEl.textContent = buildAlignedLine(width, subjectToken, 'Site Manual', subjectToken);
      }
      const footerEl = document.querySelector<HTMLElement>('[data-footer]');
      if (footerEl) {
        footerEl.textContent = buildAlignedLine(width, ctx.hostname, today, subjectToken);
      }
    }

    function makeLink(href: string, label: string): HTMLAnchorElement {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = label;
      a.className = LINK_CLASS;
      return a;
    }

    function buildSeeAlso(): void {
      const seeAlsoEl = document.querySelector<HTMLElement>('[data-see-also]');
      if (!seeAlsoEl) return;

      seeAlsoEl.replaceChildren();

      const entries: HTMLAnchorElement[] = [];

      if (isMainSite) {
        entries.push(
          makeLink('/', 'home(1)'),
          makeLink('/blog', 'blog(1)'),
          makeLink('/#projects', 'projects(1)'),
        );
      } else {
        const backLink = makeLink('#', 'back(1)');
        backLink.addEventListener('click', (e) => {
          e.preventDefault();
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = MAIN_SITE_URL;
          }
        });
        entries.push(backLink);

        const ref = document.referrer;
        if (ref) {
          try {
            const refHost = stripWww(new URL(ref).hostname);
            if (refHost && refHost !== ctx.hostname) {
              entries.push(makeLink(ref, `${refHost}(1)`));
            }
          } catch {
            // malformed referrer; skip the link rather than crash the page
          }
        }

        entries.push(makeLink(MAIN_SITE_URL, `${MAIN_SITE}(1)`));
      }

      entries.forEach((el, i) => {
        if (i > 0) seeAlsoEl.appendChild(document.createTextNode(', '));
        seeAlsoEl.appendChild(el);
      });
    }

    buildSeeAlso();

    const runLayout = (): void => {
      applyAlignment();
      document.querySelectorAll<HTMLElement>('.pill-group').forEach((group) => {
        initMagicPill(group);
      });
    };

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(runLayout);
    } else {
      runLayout();
    }
  </script>
</Base>

---
import Base from '@layouts/Base.astro';
---

<Base title="404 (oneliner) — Taylor Silenzio">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center justify-center px-6 pt-32 pb-20 text-center"
  >
    <h1 class="text-6xl font-bold text-(--color-text-muted)">404</h1>
    <p class="mt-4 text-(--color-text-muted)">
      I haven't built that page, or I moved it, or I broke it. One of the three.
    </p>
    <a
      href="/"
      class="mt-6 rounded-md bg-(--color-bg-alt) px-4 py-2 text-sm hover:bg-(--color-border) transition-colors"
    >
      Go home
    </a>
  </div>
</Base>

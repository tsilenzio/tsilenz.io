---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<section data-trace-section="writing" class="reveal mx-auto max-w-3xl px-6 pb-20">
  <div class="flex items-baseline justify-between mb-6">
    <h2 class="text-xl font-semibold">Writing</h2>
    {
      posts.length > 0 && (
        <a href="/blog" class="text-sm text-(--color-text-muted) hover:text-(--color-accent)">
          View all &rarr;
        </a>
      )
    }
  </div>

  {
    posts.length > 0 ? (
      <div class="space-y-4">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group block rounded-lg p-4 -mx-4 hover:bg-(--color-bg-alt) transition-colors"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-medium group-hover:text-(--color-accent) transition-colors">
                {post.data.title}
              </h3>
              <time
                class="shrink-0 text-sm text-(--color-text-muted)"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </time>
            </div>
            {post.data.description && (
              <p class="mt-1 text-sm text-(--color-text-muted)">{post.data.description}</p>
            )}
          </a>
        ))}
      </div>
    ) : (
      <p class="text-sm text-(--color-text-muted)">
        Posts coming soon. In the meantime, check out my <a href="/#projects">projects</a>.
      </p>
    )
  }
</section>

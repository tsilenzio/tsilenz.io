---
import Icon from '@ui/Icon.astro';

// The SSH terminal callout. Prop-driven so the caller positions it (replaces the v1
// SshCallout + v2 WhoamiCallout pair). Caption content goes in the default slot.
interface Props {
  command: string;
  label?: string;
  class?: string;
}

const { command, label = 'Terminal', class: className } = Astro.props;
---

<div
  class:list={[
    'rounded-lg border border-(--color-border) bg-(--color-bg-alt) p-3.5 font-mono text-sm',
    className,
  ]}
>
  <div class="mb-2.5 flex items-center gap-2 text-(--color-text-muted)">
    <Icon name="terminal" class="size-4" />
    <span>{label}</span>
  </div>
  <div class="flex items-center gap-2">
    <span class="select-none text-(--color-text-muted)">$</span>
    <code class="text-(--color-accent)" data-trace-copy="ssh-command">{command}</code>
  </div>
  <p class="mt-3 font-sans text-xs text-(--color-text-muted)">
    <slot />
  </p>
</div>

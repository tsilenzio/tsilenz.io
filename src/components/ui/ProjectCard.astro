---
import Badge from '@ui/Badge.astro';
import Icon from '@ui/Icon.astro';
import { STATUS_LABEL } from '@/types';
import type { Project } from '@/types';

type Props = Project;

const { slug, title, description, status, tech, href } = Astro.props;

// Whole card is one link when there's an href, so the pointer cursor covers the
// entire surface rather than just the title (matches the blog-entry pattern).
const Tag = href ? 'a' : 'div';
const linkAttrs = href
  ? { href, target: '_blank', rel: 'noopener noreferrer', 'data-trace-event': `project-${slug}` }
  : {};

// Hover lift, linked cards only. Dark mode reads the lift from the lighter surface
// (--color-bg-card-hover); light mode from the shadow, since its card is already white
// and can't lighten. The border shifts color on hover but not width, so the content box
// stays fixed and a long description can't reflow into an extra line and jump the grid.
const CARD_BASE =
  'group flex h-full flex-col rounded-lg border border-(--color-border) bg-(--color-bg-card) p-5 transition-all duration-200';
const CARD_HOVER =
  'hover:-translate-y-0.5 hover:border-(--color-accent)/30 hover:bg-(--color-bg-card-hover) hover:shadow-lg hover:shadow-(--color-accent)/5 motion-reduce:transform-none';
const cardClass = href ? `${CARD_BASE} ${CARD_HOVER}` : CARD_BASE;
---

<Tag class={cardClass} {...linkAttrs}>
  <div class="flex items-start justify-between gap-3">
    <h3
      class:list={[
        'font-semibold text-(--color-text)',
        href && 'transition-colors group-hover:text-(--color-accent)',
      ]}
    >
      {title}
      {
        href && (
          <Icon
            name="arrow"
            class="ml-1 inline-block size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transform-none"
          />
        )
      }
    </h3>
    <Badge variant={status} class="shrink-0">{STATUS_LABEL[status]}</Badge>
  </div>
  <p class="mt-2 text-sm text-(--color-text-muted)">{description}</p>
  <div class="mt-auto flex flex-wrap gap-1.5 pt-3">
    {tech.map((t) => <span class="tech-chip">{t}</span>)}
  </div>
</Tag>

<style>
  /* Tech-tag chip with the elevated surface + dim border (Material elevation: lighter
     than the card in dark, darker in light). */
  .tech-chip {
    display: inline-block;
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-text);
    background-color: #323e51;
    border: 1px solid rgba(226, 232, 240, 0.16);
  }
  :global(:root.light) .tech-chip {
    background-color: #f3f4f6;
    border-color: rgba(15, 23, 42, 0.16);
  }
</style>

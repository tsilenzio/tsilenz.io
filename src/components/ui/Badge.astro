---
import type { ProjectStatus } from '@/types';

interface Props {
  variant: ProjectStatus;
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<span class:list={['badge', `badge-${variant}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-block;
    flex-shrink: 0;
    border-radius: 9999px;
    padding: 0.125rem 0.625rem;
    font-size: 0.75rem;
    line-height: 1rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* All variants read the --status-* palette (defined per theme in global.css). */
  .badge-in-progress {
    background-color: var(--status-progress-bg);
    color: var(--status-progress-fg);
    border: 1px solid var(--status-progress-border);
  }

  .badge-active {
    background-color: var(--status-active-bg);
    color: var(--status-active-fg);
    border: 1px solid var(--status-active-border);
  }

  .badge-on-hold,
  .badge-planned {
    background-color: var(--status-planned-bg);
    color: var(--status-planned-fg);
    border: 1px solid var(--status-planned-border);
  }
</style>

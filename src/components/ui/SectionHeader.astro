---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<h2 class="mb-6 flex items-center gap-4 font-mono text-[1.2rem]">
  <span class="shrink-0"><span class="text-(--color-accent)">//</span> {label}</span>
  <span class="h-px flex-1 bg-(--color-border)"></span>
  <slot />
</h2>

---
interface Props {
  title: string;
  description: string;
  status: 'Active' | 'In Progress' | 'On Hold' | 'Planned';
  tech: string[];
  href?: string;
}

const { title, description, status, tech, href } = Astro.props;

const statusColors = {
  Active: 'bg-(--color-status-active)/15 text-(--color-status-active)',
  'In Progress': 'bg-(--color-status-progress)/15 text-(--color-status-progress)',
  'On Hold': 'bg-(--color-status-planned)/15 text-(--color-status-planned)',
  Planned: 'bg-(--color-status-planned)/15 text-(--color-status-planned)',
} as const;
---

<div
  class="group flex h-full flex-col rounded-lg border border-(--color-border) bg-(--color-bg-card) p-5 transition-all duration-200 hover:border-(--color-accent)/30 hover:shadow-lg hover:shadow-(--color-accent)/5"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold">
      {
        href ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-(--color-text) hover:text-(--color-accent) transition-colors"
          >
            {title}
            <svg
              class="ml-1 inline-block size-3.5 opacity-0 group-hover:opacity-100 transition-opacity"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M7 17L17 7M17 7H7M17 7V17" />
            </svg>
          </a>
        ) : (
          title
        )
      }
    </h3>
    <span class={`shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium ${statusColors[status]}`}>
      {status}
    </span>
  </div>
  <p class="mt-2 text-sm text-(--color-text-muted)">{description}</p>
  <div class="mt-auto pt-3 flex flex-wrap gap-1.5">
    {
      tech.map((t) => (
        <span class="rounded-md bg-(--color-bg-alt) px-2 py-0.5 text-xs text-(--color-text-muted)">
          {t}
        </span>
      ))
    }
  </div>
</div>

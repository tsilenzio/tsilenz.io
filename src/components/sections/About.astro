---
import { Image } from 'astro:assets';
import meImage from '../../assets/me.jpg';
import SocialLinks from '@ui/SocialLinks.astro';
import Terminal from '@ui/Terminal.astro';
import SectionHeader from '@ui/SectionHeader.astro';
import { site } from '@/config';
---

<section id="about" class="reveal mb-20 scroll-mt-24">
  {/* identity header block (below xl) — nested so the "about" anchor lands on it */}
  <div
    class="flex flex-col items-start gap-6 pt-16 pb-12 sm:flex-row sm:items-start sm:gap-8 sm:pt-24 sm:pb-16 xl:hidden"
  >
    <Image
      src={meImage}
      alt={site.name}
      width={320}
      height={320}
      loading="eager"
      class="size-28 shrink-0 rounded-full border border-(--color-border) object-cover sm:size-40"
    />
    <div>
      <h1 class="text-4xl font-bold tracking-tight">{site.name}</h1>
      <div class="mt-2 flex flex-col items-start gap-2.5">
        <span class="text-lg text-(--color-text-muted)">{site.role}</span>
        <span class="flex items-center gap-2 text-xs font-medium text-(--color-status-active)">
          <span class="size-1.5 rounded-full bg-(--color-status-active)"></span>
          {site.availability}
        </span>
      </div>
      <p class="mt-4 max-w-lg leading-relaxed text-(--color-text-muted)">{site.bio}</p>
      <SocialLinks class="mt-5" trace="hero" />
    </div>
  </div>
  <SectionHeader label="about" />
  <p class="mb-4 leading-relaxed text-(--color-text-muted)">
    I'm a software engineer who likes the unglamorous layer: event-driven pipelines, real-time
    systems, and the developer tooling that makes the rest of the team faster. Most of my career has
    been Node.js backends at scale. Lately I've been bringing Rust into the places it earns its
    keep.
  </p>
  <p class="leading-relaxed text-(--color-text-muted)">
    At Keller Williams I built data pipelines and notification systems for a real estate platform
    serving 180K+ agents, and rewrote a translation-sync CLI from Go into Rust. Outside work I run a
    single-node Proxmox homelab and build small CLIs and TUIs.
  </p>

  <div class="mt-8">
    <Terminal command="ssh whoami.tsilenz.io">
      See what my SSH server knows about you. Built in
      <a href={site.github} target="_blank" rel="noopener noreferrer">Rust</a>.
    </Terminal>
  </div>
</section>

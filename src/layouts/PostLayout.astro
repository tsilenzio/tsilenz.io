---
import PageLayout from './PageLayout.astro';
import { site } from '@/config';

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
}

const { title, description, date, tags = [] } = Astro.props;
---

<PageLayout
  title={`${title} — ${site.name}`}
  description={description}
  ogTitle={title}
  ogType="article"
>
  <article class="mx-auto max-w-3xl px-6 pt-24 pb-20">
    <header class="mb-10">
      <a
        href="/blog"
        class="text-sm text-(--color-text-muted) transition-colors hover:text-(--color-accent)"
      >
        &larr; Back to writing
      </a>
      <h1 class="mt-4 text-3xl font-bold tracking-tight">{title}</h1>
      <div class="mt-3 flex items-center gap-3 text-sm text-(--color-text-muted)">
        <time datetime={date.toISOString()}>
          {
            date.toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            })
          }
        </time>
        {
          tags.length > 0 && (
            <>
              <span>&middot;</span>
              <div class="flex gap-1.5">
                {tags.map((tag) => (
                  <span class="rounded-md bg-(--color-bg-alt) px-2 py-0.5 text-xs">{tag}</span>
                ))}
              </div>
            </>
          )
        }
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</PageLayout>

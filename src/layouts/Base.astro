---
import '../styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Taylor Silenzio',
  description = 'Software engineer building tools and infrastructure.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    {/* Inline theme init to prevent FOUC */}
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var preferLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (stored === 'light' || (!stored && preferLight)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-(--color-bg) text-(--color-text) transition-colors duration-200">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script src="@scripts/theme.ts"></script>
    <script src="@scripts/reveal.ts"></script>
    <script src="@scripts/beacon.ts"></script>
  </body>
</html>
